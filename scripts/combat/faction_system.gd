static func get_unit_factions(unit_id: String) -> Array[String]:
	var list: Array[String] = []
	for f_key in FACTIONS:
		var members: Array = FACTIONS[f_key].get("members", [])
		if unit_id in members:
			list.append(f_key)
	return list

static func have_shared_faction(id1: String, id2: String) -> bool:
	if id1.is_empty() or id2.is_empty():
		return false
	var f1 := get_unit_factions(id1)
	var f2 := get_unit_factions(id2)
	for f in f1:
		if f in f2:
			return true
	return false
